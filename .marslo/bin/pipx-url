""" list pipx venvs with their source URL """

import json
import subprocess

d = json.loads( subprocess.check_output(["pipx", "list", "--json"]) )
rows = []
for n, v in sorted( d["venvs"].items() ):
    m = v["metadata"]["main_package"]
    rows.append( (n, m.get("package_version") or "", m["package_or_url"]) )
wn = max( len(r[0]) for r in rows )
wv = max( len(r[1]) for r in rows )
for name, ver, src in rows:
    print( f"{name:<{wn}} : {ver:<{wv}} <- {src}" )

print( 'done' )

