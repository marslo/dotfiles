#!/usr/bin/env bash
# shellcheck source=/dev/null
#=============================================================================
#     FileName : jira-ls
#       Author : marslo
#      Created : 2026-01-21 20:57:09
#   LastChange : 2026-09-15 21:08:47
#=============================================================================

set -euo pipefail

# shellcheck disable=SC2155
declare -r ME="$( basename "${BASH_SOURCE[0]:-$0}" | sed 's/-/ /' )"
# @credit: https://github.com/ppo/bash-colors
# shellcheck disable=SC2015,SC2059
c() { [ $# == 0 ] && printf "\033[0m" || printf "$1" | sed 's/\(.\)/\1;/g;s/\([SDIUFNHT]\)/2\1/g;s/\([KRGYBMCW]\)/3\1/g;s/\([krgybmcw]\)/4\1/g;y/SDIUFNHTsdiufnhtKRGYBMCWkrgybmcw/12345789123457890123456701234567/;s/^\(.*\);$/\\033[\1m/g'; }

declare -r JIRA_URL="${JIRA_URL:-https://jira.domain.com}"
declare -r JIRA_USER="${JIRA_USER:-marslo}"
# per-project epic link field ( customfield id differs per project ); holds the epic's issue key, resolved to the epic name for display
declare -A EPIC_FIELD=( ['PROJ1']='customfield_10066' )
declare -A PROJECTS_ID=( ['PROJ1']='23918' ['PROJ2']='23917' ['PROJ3']='18308' ['PROJ4']='15014' )
declare _PROJECT='PROJ1'
declare -a PROJECTS=()
declare RETURN_TYPE='full'
declare UPDATE_LIMIT=''
declare ASSIGNEE=''
declare REPORTER=''
declare TRANSITION=''
declare COMMENT=''
declare LIST_LABELS=false
declare -a ADD_LABELS=()
declare -a REMOVE_LABELS=()
declare -a JIRA_KEYS=()
declare -a KEYS=()
declare -a CURRENT_STATUS=()
declare -A JQL_MAP=(
  ['new']='status in (New, Open)'
  ['in-progress']='status in (Active, "In Progress", "In Review")'
  ['todo']='status in ("To Do")'
  ['open']='status in (Open, New, Active, "To Do", "In Progress", "In Review")'
  ['closed']='status = Closed OR resolution in (Done, Fixed)'
)
# map `--to` target aliases to a comma-separated spec: 'STATUS[,RESOLUTION...]'
declare -A TRANSITION_MAP=(
  ['in-progress']='In Progress'
  ['close']='Closed,Completed,Done,Fixed'
  ['closed']='Closed,Completed,Done,Fixed'
  ['done']='Done,Done'
)

# shellcheck disable=SC2155
declare -r USAGE="NAME
  $(c Ys)${ME}$(c) - List and manage JIRA issues — pick with $(c i)fzf$(c) or pass $(c 0Mi)JIRA-ID$(c)(s), then transition, comment, or manage labels.

SYNOPSIS
  $(c Ys)\$ ${ME} $(c 0G)[OPTIONS] $(c 0Cs)[JIRA-ID...]$(c)

OPTIONS
  $(c G)-j$(c), $(c G)--jira $(c 0Mi)JIRA-ID$(c)         act on the given issue(s) directly, skipping the $(c i)fzf$(c) picker $(c 0i)(comma-separated or repeat the flag; bare $(c 0Mi)JIRA-ID$(c 0i) args work too)$(c)
  $(c G)-p$(c), $(c G)--project $(c 0Mi)PROJECT_KEY$(c)  specify the JIRA project key $(c 0i)(default: $(c 0Mi)'${_PROJECT}'$(c 0i))$(c)
  $(c G)--assignee$(c) $(c 0Mi)USER_ID$(c)         filter issues assigned to the specified user $(c 0i)(no value means $(c 0Mi)currentUser()$(c 0i))$(c)
  $(c G)--reporter$(c) $(c 0Mi)USER_ID$(c)         filter issues reported by the specified user $(c 0i)(no value means $(c 0Mi)currentUser()$(c 0i))$(c)
  $(c G)-u$(c), $(c G)--update $(c 0Mi)FILTER$(c)        filter issues updated within the specified time frame $(c 0i)(e.g., $(c 0Mi)'-4w'$(c 0i) for 4 weeks)$(c)

  $(c B)--open$(c)                     list issues with $(c Bi)status $(c 0i)in ($(c 0Ci)'New'$(c 0i),$(c 0Ci)'Active'$(c 0i),$(c 0Ci)'To Do'$(c 0i),$(c 0Ci)'In Progress'$(c 0i))$(c) $(c 0i)(default)$(c)
  $(c B)--new$(c)                      list issues with $(c Bi)status $(c 0Ci)'New'$(c) or $(c 0Ci)'Active'$(c)
  $(c B)--in-progress$(c)              list issues with $(c Bi)status $(c 0Ci)'In Progress'$(c)
  $(c B)--todo$(c)                     list issues with $(c Bi)status $(c 0Ci)'To Do'$(c)
  $(c B)--closed$(c)                   list issues with $(c Bi)status $(c 0Ci)'Closed'$(c 0i) or $(c Bi)resolution $(c 0i)in ($(c 0Ci)'Done'$(c 0i),$(c 0Ci)'Fixed'$(c 0i))$(c)
                             filter in $(c 0Mi)4 weeks$(c) by default

  $(c Y)--to $(c 0Bi)STATUS$(c)                transition the $(c i)selected$(c) issue to $(c 0Bi)STATUS$(c) $(c 0i)( available: $(c 0Ci)'in-progress'$(c 0i), $(c 0Ci)'close'$(c 0i), $(c 0Ci)'done'$(c 0i))$(c)
  $(c Y)-c$(c), $(c Y)--add-comment $(c 0Mi)TEXT$(c)     add a comment $(c 0Mi)TEXT$(c) to the $(c i)selected$(c) issue
  $(c Y)-l$(c), $(c Y)--add-label $(c 0Mi)LABEL$(c)      add $(c 0Mi)LABEL$(c)(s) to the $(c i)selected$(c) issue $(c 0i)(comma-separated or repeat the flag)$(c)
  $(c Y)--remove-label $(c 0Mi)LABEL$(c)       remove $(c 0Mi)LABEL$(c)(s) from the $(c i)selected$(c) issue $(c 0i)(comma-separated or repeat the flag)$(c)
  $(c Y)--list-label$(c)               list the current labels of the $(c i)selected$(c) issue(s)

  $(c G)-r$(c), $(c G)--return $(c 0Mi)TYPE$(c)          specify the return format $(c 0i)(default: $(c 0Mi)full$(c 0i))$(c). $(c 0Mi)full$(c) for key and summary; $(c 0Mi)short$(c) for key only
  $(c G)-h$(c), $(c G)--help$(c)                 show this help message and exit

EXAMPLE
  $(c Wdi)# list 2 weeks in-progress jira ticket in project 'PROJECT_KEY' and 'NEWID' for \`currentUser()\`$(c)
  $(c Ys)\$ ${ME} $(c 0Gi)--project $(c 0Mi)PROJECT_KEY $(c 0Gi)--project $(c 0Mi)NEWID $(c 0Bi)--in-progress $(c 0Gi)--assignee -u $(c 0Mi)'-2w'$(c)

  $(c Wdi)# list closed and todo tickets in default project for user 'alice' after '2026-03-01 14:30'$(c)
  $(c Ys)\$ ${ME} $(c 0Bi)--todo --closed $(c 0Gi)--assignee $(c 0Mi)alice $(c 0Gi)--update $(c 0Mi)'2026-03-01 14:30'$(c)

  $(c Wdi)# list open tickets, then move the selected one to 'In Progress'$(c)
  $(c Ys)\$ ${ME} $(c 0Bi)--open $(c 0Yi)--to $(c 0Ci)in-progress$(c)

  $(c Wdi)# list open tickets, then add a comment to the selected one$(c)
  $(c Ys)\$ ${ME} $(c 0Bi)--open $(c 0Yi)--add-comment $(c 0Mi)'working on it now'$(c)

  $(c Wdi)# list open tickets, then add labels to and remove a label from the selected one$(c)
  $(c Ys)\$ ${ME} $(c 0Bi)--open $(c 0Yi)--add-label $(c 0Mi)'Linux,kernel' $(c 0Yi)--remove-label $(c 0Mi)'wip'$(c)
  $(c Wdi)# act on specific JIRA ID(s) directly, skipping fzf ( bare ids, comma-separated, or --jira )$(c)
  $(c Ys)\$ ${ME} $(c 0Mu)PROJ-123$(c),$(c 0Mu)PROJ-456$(c 0Yi) --to $(c 0Ci)done$(c)
  $(c Ys)\$ ${ME} $(c 0Gi)--jira $(c 0Mu)PROJ-123$(c 0Gi) --jira $(c 0Mu)PROJ-456$(c 0Yi) --add-label $(c 0Mi)'wip'$(c)
"

function passToken() { type -P pass >/dev/null || die "JIRA API token not found. Please set the \`JIRA_API_TOKEN\` environment variable"; pass show "${1}" | head -n1; }
function showUsage() { echo -e "${USAGE}"; exit 0;  }
function dieWithCode { echo -e "$(c Ri)ERROR$(c 0i): $1 :$(c)"; shift; echo -e "$(c 0Wi)\`\`\`\n$*\n\`\`\`\n$(c 0Wdi)exit ...$(c)"; exit 1; }
function die()  { echo -e "$(c Ri)ERROR$(c 0i): $*.$(c) $(c Wdi)exit ...$(c)" >&2; exit 1; }
function trim() { IFS='' read -r str; echo "${str}" | sed -e 's/^[[:blank:]]*//;s/[[:blank:]]*$//'; }

# verify required tools and config exist before doing any work; die listing whatever is missing.
function preflight() {
  local -a required=( curl jq )
  # fzf is only needed for the interactive picker, so skip it in direct-id mode ( JIRA_KEYS non-empty )
  test 0 -eq "${#JIRA_KEYS[@]}" && required+=( fzf )
  local -a missing=()
  local tool
  for tool in "${required[@]}"; do
    command -v "${tool}" >/dev/null 2>&1 || missing+=( "${tool}" )
  done
  test 0 -eq "${#missing[@]}" || die "missing required tool(s): $(c 0Mi)$(IFS=', '; echo "${missing[*]}")$(c 0i)"
  test 'https://jira.domain.com' != "${JIRA_URL}" || die "JIRA_URL is not configured. Please set the \`JIRA_URL\` environment variable first"
  local osUser; osUser="$( id -un )"
  test 'marslo' = "${osUser}" || test 'marslo' != "${JIRA_USER}" || die "JIRA_USER is not configured for user $(c 0Mi)'${osUser}'$(c 0i). Please set the \`JIRA_USER\` environment variable first"
}

# GET the available transitions for an issue key ( expand transitions.fields to reveal whether `resolution` is settable )
function getTransitions() {
  "${CURL_CMD[@]}" --get --data-urlencode 'expand=transitions.fields' "${JIRA_URL}/rest/api/2/issue/${1}/transitions"
}

# transition an issue to a target status via the JIRA API
#   $1: issue key ; $2: target status name (e.g. 'In Progress', 'Closed')
function doTransition() {
  # $2 is a 'STATUS[,RESOLUTION...]' spec (see TRANSITION_MAP)
  local key="$1" spec="$2" target resolutions transitions tid payload resp
  target="${spec%%,*}"
  resolutions=''; [[ "${spec}" == *,* ]] && resolutions="${spec#*,}"
  transitions="$( getTransitions "${key}" )"

  if echo "${transitions}" | jq -e 'has("errorMessages")' >/dev/null 2>&1; then
    dieWithCode 'JIRA API Error' "$(echo "${transitions}" | jq -r '.errorMessages[]')"
  fi

  # prefer matching by the transition's target status name, fallback to transition name
  tid="$( echo "${transitions}" |
          jq -r --arg t "${target}" '.transitions[] | select((.to.name | ascii_downcase) == ($t | ascii_downcase)) | .id' |
          head -n1
        )"
  if test -z "${tid}"; then
    tid="$( echo "${transitions}" |
            jq -r --arg t "${target}" '.transitions[] | select((.name | ascii_downcase) == ($t | ascii_downcase)) | .id' |
            head -n1
          )"
  fi
  test -n "${tid}" || die "no transition to '${target}' available for ${key}. available: $(c 0Mi)$( echo "${transitions}" | jq -r '[.transitions[].to.name] | join(", ")' )$(c 0i)"

  # build the transition payload
  # gotcha: a transition exposing a `resolution` field requires it set explicitly ( else jira defaults it to 'Open' ). pick the first configured resolution name the transition actually offers
  payload="$( echo "${transitions}" | jq -c --arg tid "${tid}" --arg resolutions "${resolutions}" '
    ( .transitions[] | select(.id == $tid) ) as $tr
    | ( $resolutions | if . == "" then [] else split(",") end ) as $prefer
    | { transition: { id: $tid } }
    + ( if ( ($prefer | length) > 0 ) and ( $tr.fields // {} | has("resolution") ) then
          ( $tr.fields.resolution.allowedValues // [] | map(.name) ) as $allowed
          | ( $prefer | map( select( . as $n | $allowed | index($n) ) ) | first ) as $pick
          | if $pick then { fields: { resolution: { name: $pick } } } else {} end
        else {} end )
  ' )"

  resp="$( "${CURL_CMD[@]}" \
           --request POST \
           --header 'Content-Type: application/json' \
           --data "${payload}" \
           "${JIRA_URL}/rest/api/2/issue/${key}/transitions"
         )"
  # a successful transition returns HTTP 204 with an empty body
  if test -n "${resp}" && echo "${resp}" | jq -e 'has("errorMessages") or has("errors")' >/dev/null 2>&1; then
    dieWithCode 'JIRA transition failed' "$(echo "${resp}" | jq -rc '.errorMessages, .errors')"
  fi
}

# add a comment to an issue via the JIRA API
#   $1: issue key ; $2: comment body
function addComment() {
  local key="$1" body="$2" payload resp
  payload="$( jq -n --arg b "${body}" '{body: $b}' )"
  resp="$( "${CURL_CMD[@]}" \
           --request POST \
           --header 'Content-Type: application/json' \
           --data "${payload}" \
           "${JIRA_URL}/rest/api/2/issue/${key}/comment"
         )"
  if echo "${resp}" | jq -e 'has("errorMessages") or has("errors")' >/dev/null 2>&1; then
    die "JIRA add comment failed: $(echo "${resp}" | jq -rc '.errorMessages, .errors')"
  fi
  echo "${resp}" | jq -e 'has("id")' >/dev/null 2>&1 || dieWithCode 'JIRA add comment failed' "${resp}"
}

# add/remove labels on an issue via an atomic partial update
#   $1: issue key ; consumes global ADD_LABELS / REMOVE_LABELS
function updateLabels() {
  local key="$1" addJson removeJson payload resp
  # build JSON arrays via --args positional so label values with spaces survive
  addJson="$( jq -n '$ARGS.positional' --args "${ADD_LABELS[@]}" )"
  removeJson="$( jq -n '$ARGS.positional' --args "${REMOVE_LABELS[@]}" )"
  payload="$( jq -n --argjson add "${addJson}" --argjson remove "${removeJson}" '
    { update: { labels: ( ($add | map({ add: . })) + ($remove | map({ remove: . })) ) } }
  ' )"

  resp="$( "${CURL_CMD[@]}" \
           --request PUT \
           --header 'Content-Type: application/json' \
           --data "${payload}" \
           "${JIRA_URL}/rest/api/2/issue/${key}"
         )"
  # a successful update returns HTTP 204 with an empty body
  if test -n "${resp}" && echo "${resp}" | jq -e 'has("errorMessages") or has("errors")' >/dev/null 2>&1; then
    dieWithCode 'JIRA label update failed' "$(echo "${resp}" | jq -rc '.errorMessages, .errors')"
  fi
}

# echo an issue's labels as a comma-separated string ( empty when none )
#   $1: issue key
function listLabels() {
  local key="$1" resp
  resp="$( "${CURL_CMD[@]}" --get --data-urlencode 'fields=labels' "${JIRA_URL}/rest/api/2/issue/${key}" )"
  if echo "${resp}" | jq -e 'has("errorMessages")' >/dev/null 2>&1; then
    dieWithCode 'JIRA API Error' "$(echo "${resp}" | jq -r '.errorMessages[]')"
  fi
  echo "${resp}" | jq -r '.fields.labels | join(", ")'
}

# echo a JSON object mapping every referenced epic key to its epic name ( '{}' when none ). jira exposes the epic link as a key ( see EPIC_FIELD ) but shows the epic name; resolve in two calls
#   reads globals `json` / `EPIC_FIELDS_JSON` ; discovers the epic-name field, then batch-fetches the epics
function resolveEpics() {
  local -a keys=()
  # each issue's epic link lives in a per-project custom field ( $ef keyed by project )
  mapfile -t keys < <( echo "${json}" | jq -r --argjson ef "${EPIC_FIELDS_JSON}" '
    [ .issues[]
      | ( $ef[.fields.project.key] // "" ) as $f
      | if $f == "" then empty else ( .fields[$f] // empty ) end
    ] | unique | .[]
  ' )
  test 0 -lt "${#keys[@]}" || { echo '{}'; return 0; }

  # the epic-name field id varies per instance; match by greenhopper schema or display name
  local nameField
  nameField="$( "${CURL_CMD[@]}" --get "${JIRA_URL}/rest/api/2/field" |
                jq -r 'map(select(.schema.custom == "com.pyxis.greenhopper.jira:gh-epic-label" or .name == "Epic Name")) | .[0].id // empty' 2>/dev/null || true
            )"

  local fields='summary' jql resp
  test -n "${nameField}" && fields="summary,${nameField}"
  jql="issuekey in ($(IFS=','; echo "${keys[*]}"))"
  resp="$( "${CURL_CMD[@]}" --data-urlencode "jql=${jql}" --data-urlencode "fields=${fields}" --get "${JIRA_URL}/rest/api/2/search" )" || resp=''

  # prefer the epic-name field, fall back to summary, then the key itself
  echo "${resp}" | jq -c --arg f "${nameField}" '
    ( .issues // [] )
    | map({ key: .key, value: ( ( if $f != "" then .fields[$f] else null end ) // .fields.summary // .key ) })
    | from_entries
  ' 2>/dev/null || echo '{}'
}
# validate comma-separated JIRA ids and append them ( uppercased ) to JIRA_KEYS; die on any malformed token
#   $1: comma-separated ids ; $2: source label for the error message
function collectKeys() {
  local raw="$1" src="$2" k
  local -a parts=()
  IFS=',' read -ra parts <<< "${raw}"
  for k in "${parts[@]}"; do
    k="$( echo "${k}" | trim )"; k="${k^^}"
    test -n "${k}" || continue
    [[ "${k}" =~ ^[A-Z]+-[0-9]+$ ]] || die "${src} expects a JIRA id like $(c 0Mi)'IPBUSW-123'$(c 0i), got $(c 0Mi)'${k}'$(c 0i)"
    JIRA_KEYS+=( "${k}" )
  done
}

# echo 'ID: Summary' for the given issue keys via a single summary-only search ( for --full in direct-id mode )
#   $@: issue keys
function printFull() {
  local resp
  resp="$( "${CURL_CMD[@]}" --data-urlencode "jql=issuekey in ($(IFS=', '; echo "$*"))" --data-urlencode 'fields=summary' --get "${JIRA_URL}/rest/api/2/search" )"
  if echo "${resp}" | jq -e 'has("errorMessages")' >/dev/null 2>&1; then
    die "JIRA API Error: $(echo "${resp}" | jq -r '.errorMessages[]')"
  fi
  echo "${resp}" | jq -r '.issues[] | "\(.key): \(.fields.summary)"'
}

while test $# -gt 0; do
  case "$1" in
    -h | --help             ) showUsage                         ;;
    -r | --return           ) case "${2:-}" in
                                full | short ) RETURN_TYPE="$2" ;;
                                *            ) die "'--return' must be 'full' or 'short', got '$2'" ;;
                              esac
                              shift 2                           ;;
    -p | --project          ) PROJECTS+=( "$2" ) ; shift 2      ;;
    -u | --update           ) UPDATE_LIMIT="$2"  ; shift 2      ;;
    --to                    ) test -n "${2:-}" || die "'--to' requires a target status (e.g. $(IFS=', '; echo "${!TRANSITION_MAP[*]}"))"
                              test -n "${TRANSITION_MAP[${2,,}]:-}" || die "'--to' unknown target '$2' (e.g. $(IFS=', '; echo "${!TRANSITION_MAP[*]}"))"
                              TRANSITION="${TRANSITION_MAP[${2,,}]}"
                              shift 2                           ;;
    -c | --add-comment      ) test -n "${2:-}" || die "'$1' requires a comment text"
                              COMMENT="$2"; shift 2             ;;
    -l | --add-label | --add-labels  )
                              test -n "${2:-}" || die "'$1' requires label(s)"
                              IFS=',' read -ra _labels <<< "$2"
                              for _l in "${_labels[@]}"; do
                                _l="$( echo "${_l}" | trim )"
                                test -n "${_l}" && ADD_LABELS+=( "${_l}" )
                              done
                              shift 2                           ;;
    --remove-label | --remove-labels )
                              test -n "${2:-}" || die "'$1' requires label(s)"
                              IFS=',' read -ra _labels <<< "$2"
                              for _l in "${_labels[@]}"; do
                                _l="$( echo "${_l}" | trim )"
                                test -n "${_l}" && REMOVE_LABELS+=( "${_l}" )
                              done
                              shift 2                           ;;
    --list-label | --list-labels     )
                              LIST_LABELS=true; shift           ;;
    -j | --jira | --jira-id ) test -n "${2:-}" || die "'$1' requires a JIRA id (e.g. PROJ-123)"
                              collectKeys "$2" "$1"; shift 2    ;;
    --assignee | --reporter ) PARAM="${1#--}"; PARAM="${PARAM^^}";
                              if [[ -n "${2:-}" && "$2" != -* ]]; then
                                printf -v "${PARAM}" "%s" "$2"; shift 2;
                              else
                                printf -v "${PARAM}" "%s" "currentUser()"; shift 1;
                              fi                                ;;
    --*                     ) KEY="${1#--}"
                              if [[ -n "${JQL_MAP[${KEY}]}" ]]; then
                                KEYS+=( "${KEY}" ); shift ;
                              else
                                die "Unknown option '$1'"
                              fi                                ;;
    *                       ) collectKeys "$1" "argument"; shift ;;
  esac
done
# run now that JIRA_KEYS is known, so fzf is only required in interactive mode; validates JIRA_USER before it is used
preflight
# fetch the token after preflight so a wrong/unset JIRA_USER is caught before the pass path / auth use it
declare -r JIRA_API_TOKEN="${JIRA_API_TOKEN:-$( passToken "${PASS_JIRA:-${JIRA_USER}/jira}" )}"
test -n "${JIRA_API_TOKEN:-}" || die "JIRA API token not found. Please set the \`JIRA_API_TOKEN\` environment variable first"
declare -ar CURL_CMD=( command curl -u "${JIRA_USER}:${JIRA_API_TOKEN}" --silent --compressed )

{ test -z "${ASSIGNEE:-}" && test -z "${REPORTER:-}"; } && ASSIGNEE='currentUser()'
test 0 -eq "${#KEYS[@]}"  && KEYS=( 'open' )

# setup -4w for closed issues by default
for key in "${KEYS[@]}"; do
  jql="${JQL_MAP[${key}]}"
  if [[ "${key}" == "closed" ]] && [[ -z "${UPDATE_LIMIT:-}" ]]; then
    jql="(${jql}) AND updated >= '-4w'"
  fi
  CURRENT_STATUS+=( "(${jql})" )
done

# get final status part
declare STATUS=''
if [[ ${#CURRENT_STATUS[@]} -gt 0 ]]; then
  STATUS=$(IFS='|'; echo "${CURRENT_STATUS[*]}")
  STATUS="${STATUS//|/ OR }"
  # for multiple status ( status=(..) OR status=(..) )
  STATUS="( ${STATUS} )"
fi

declare -a IDS=()
[[ ${#PROJECTS[@]} -eq 0 ]] && PROJECTS=( "${_PROJECT}" )
for p in "${PROJECTS[@]}"; do IDS+=("${PROJECTS_ID[${p}]:-${p}}"); done

#shellcheck disable=SC2155
declare query="project in ($(IFS=', '; echo "${IDS[*]}"))"
query+="${STATUS:+ AND ${STATUS}}"
query+="${ASSIGNEE:+ AND assignee=${ASSIGNEE}}"
query+="${REPORTER:+ AND reporter=${REPORTER}}"
# shellcheck disable=SC2016
query+="${UPDATE_LIMIT:+ AND updated >= '${UPDATE_LIMIT}'}"

declare jira=''
# direct-id mode ( --jira / positional ): use the given keys as the selection; skip the interactive listing entirely
test 0 -lt "${#JIRA_KEYS[@]}" && jira="$( printf '%s\n' "${JIRA_KEYS[@]}" )"
# interactive listing ( search + render + fzf ) runs only when no explicit id was given
if test -z "${jira}"; then
declare json=''
json="$( "${CURL_CMD[@]}" --data-urlencode "jql=${query}" --get "${JIRA_URL}/rest/api/2/search" )"

if echo "${json}" | jq -e 'has("errorMessages")' >/dev/null 2>&1; then
  die "JIRA API Error: $(echo "${json}" | jq -r '.errorMessages[]')"
fi

if ! echo "${json}" | jq -e '.issues | length > 0' > /dev/null; then
  echo -e "$(c Wdi)>> $(c 0Mi)No issues found for query:\n$(c 0Wdi)\`\`\`\n${query}\n\`\`\`$(c)" >&2
  exit 0
fi

# per-project epic link field ( EPIC_FIELD ) as a JSON map for jq lookups
declare EPIC_FIELDS_JSON='{}'
EPIC_FIELDS_JSON="$(
  for pk in "${!EPIC_FIELD[@]}"; do printf '%s\t%s\n' "${pk}" "${EPIC_FIELD[${pk}]}"; done |
  jq -Rc -n '[ inputs | split("\t") | { (.[0]): (.[1]) } ] | add // {}'
)"

# resolve epic keys to names once, up front ( jq cannot make HTTP calls at render time )
declare EPICS_JSON='{}'
EPICS_JSON="$( resolveEpics )"
test -n "${EPICS_JSON}" || EPICS_JSON='{}'

declare INAME="Marslo Jiao"
declare TEMPLATE='"'
TEMPLATE+='\(.key): \(.fields.summary)'
TEMPLATE+='\t'
TEMPLATE+='Status: '
TEMPLATE+='\(if .fields.status.name | test("Done|Fixed|Closed") then "\\033[1;35m" '
TEMPLATE+='elif .fields.status.name == "To Do" then "\\033[1;90m" '
TEMPLATE+='elif .fields.status.name == "In Progress" then "\\033[1;32m" '
TEMPLATE+='else "\\033[1;36m" end)'
TEMPLATE+='\(.fields.status.name)\\033[0m\n'
TEMPLATE+='Reporter: \(if (.fields.reporter.displayName // "Unknown") != "'"${INAME}"'" then "\\033[0;3m" + (.fields.reporter.displayName // "Unknown") + "\\033[0m" else "\\033[3;36m" + (.fields.reporter.displayName // "Unknown") + "\\033[0m" end) • '
TEMPLATE+='Assignee: \(if (.fields.assignee.displayName // "Unassigned") != "'"${INAME}"'" then "\\033[0;3m" + (.fields.assignee.displayName // "Unassigned") + "\\033[0m" else "\\033[3;36m" + (.fields.assignee.displayName // "Unassigned") + "\\033[0m" end)\n'
TEMPLATE+='Created: \(.fields.created) • Updated: \(.fields.updated)\n'
TEMPLATE+='\(if ((.fields.labels // []) | length) > 0 then "Labels: \\033[1;33m" + ((.fields.labels // []) | join(", ")) + "\\033[0m\n" else "" end)'
# shellcheck disable=SC2016  # $efields / $epics are jq variables, not shell expansions
TEMPLATE+='\(( $efields[.fields.project.key] // "" ) as $ef | ( if $ef == "" then "" else (.fields[$ef] // "") end ) as $ek | if $ek != "" then "Epic: \\033[0;3;4;34m" + ($epics[$ek] // $ek) + "\\033[0m\n" else "" end)'
TEMPLATE+='\n'
TEMPLATE+='\(.fields.description)'
TEMPLATE+='"'

declare GET_ID="echo {1} | awk -F: '{printf \"%s\", \$1}'"
declare FORMAT_CONTENT="echo {1} | tr -d '\n'"
# shellcheck disable=SC2016
declare TRANSFORMER='
  default_preview=$(( FZF_LINES * 70 / 100 ))
  available=$(( FZF_LINES - FZF_MATCH_COUNT - 4 ))
  if [[ $FZF_MATCH_COUNT -eq 0 ]]; then
    echo "change-preview-window:hidden"
  elif [[ ${available} -gt ${default_preview} ]]; then
    [[ $available -gt 3 ]] && echo "change-preview-window:${available}"
  elif [[ $FZF_PREVIEW_LINES -ne ${default_preview} ]]; then
    echo "change-preview-window:${default_preview}"
  fi
'
jira="$(
  echo "${json}" | jq --argjson epics "${EPICS_JSON}" --argjson efields "${EPIC_FIELDS_JSON}" ".issues[] | ${TEMPLATE}" |
  sed -e 's/"\(.*\)"/\1/' -e 's/\\"/"/g' -e 's/\\t/\t/g' -e 's/\\\\033/\\033/g' |
  fzf --multi --with-nth=1 --ansi \
      --delimiter='\t' \
      --preview='printf "%b" {2}' \
      --preview-window='top,70%,border-bottom,wrap' \
      --bind "result:transform:${TRANSFORMER}" \
      --bind "resize:transform:${TRANSFORMER}" \
      --bind "ctrl-k:execute-silent(${GET_ID} | pbcopy)" \
      --bind "ctrl-y:execute-silent(${FORMAT_CONTENT} | pbcopy)" \
      --bind "ctrl-o:execute(${GET_ID} | xargs -I {} open ${JIRA_URL}/browse/{})" |
  cut -f1
)"
fi

# collect every selected issue key (fzf --multi may return multiple lines)
declare -a KEYS_SELECTED=()
while IFS= read -r line; do
  line="$( echo "${line%%:*}" | trim )"
  test -n "${line}" && KEYS_SELECTED+=( "${line}" )
done <<< "${jira}"

# act on the selected issue(s) when a `--to` / `--add-comment` / `--add-label` / `--remove-label` / `--list-labels` flag is present
# fzf --multi may select several issues; apply every requested operation to each in turn
if test -n "${TRANSITION:-}" || test -n "${COMMENT:-}" || test true = "${LIST_LABELS}" ||
   test 0 -lt "${#ADD_LABELS[@]}" || test 0 -lt "${#REMOVE_LABELS[@]}"; then

  test 0 -lt "${#KEYS_SELECTED[@]}" || { echo -e "$(c Wdi)>> $(c 0Mi)no issue selected$(c)" >&2; exit 0; }

  for KEY_SELECTED in "${KEYS_SELECTED[@]}"; do
    if test true = "${LIST_LABELS}"; then
      declare curLabels=''
      curLabels="$( listLabels "${KEY_SELECTED}" )"
      test -n "${curLabels}" && curLabels="$(c 0Ci)${curLabels}$(c)" || curLabels="$(c 0Wdi)(none)$(c)"
      echo -e "$(c Gi)>> ${KEY_SELECTED}$(c)$(c i) label(s): $(c)${curLabels}"
    fi

    if test -n "${TRANSITION:-}"; then
      doTransition "${KEY_SELECTED}" "${TRANSITION}"
      echo -e "$(c Gi)>> ${JIRA_URL}/browse/${KEY_SELECTED}$(c)$(c i) transitioned to $(c)$(c 0Ci)'${TRANSITION%%,*}'$(c)"
    fi

    if test -n "${COMMENT:-}"; then
      addComment "${KEY_SELECTED}" "${COMMENT}"
      echo -e "$(c Gi)>> ${KEY_SELECTED}$(c)$(c i) comment added$(c)"
    fi

    if test 0 -lt "${#ADD_LABELS[@]}" || test 0 -lt "${#REMOVE_LABELS[@]}"; then
      updateLabels "${KEY_SELECTED}"
      test 0 -lt "${#ADD_LABELS[@]}"    && echo -e "$(c Gi)>> ${KEY_SELECTED}$(c)$(c i) label(s) added: $(c)$(c 0Ci)$(IFS=', '; echo "${ADD_LABELS[*]}")$(c)"
      test 0 -lt "${#REMOVE_LABELS[@]}" && echo -e "$(c Gi)>> ${KEY_SELECTED}$(c)$(c i) label(s) removed: $(c)$(c 0Ci)$(IFS=', '; echo "${REMOVE_LABELS[*]}")$(c)"
    fi
  done

  exit 0
fi

# return ( one line per selected issue )
case "${RETURN_TYPE}" in
  short ) test 0 -lt "${#KEYS_SELECTED[@]}" && printf '%s\n' "${KEYS_SELECTED[@]}" ;;
  # interactive `jira` already carries 'ID: Summary'; direct-id `jira` is bare keys, so fetch summaries
  full  ) if test 0 -lt "${#JIRA_KEYS[@]}"; then
            test 0 -lt "${#KEYS_SELECTED[@]}" && printFull "${KEYS_SELECTED[@]}"
          else
            echo "${jira}"
          fi ;;
  *     ) die "Invalid return type '${RETURN_TYPE}'" ;;
esac

