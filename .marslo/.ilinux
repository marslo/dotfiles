# LastChange: 2026-09-02 01:19:24
# =============================================================================
# export SHELLCHECK_OPTS="-e SC2181 -e SC2230 -e SC2086 -e SC2164"

# setup in .imarslorc
# GIT_COMPLETION_DIR="/usr/share/doc/git/contrib/completion"
# ls "${GIT_COMPLETION_DIR}"/*git* >/dev/null 2>&1; [ $? -eq 0 ] && source "${GIT_COMPLETION_DIR}"/*git*.[bs]*h
## or
# GIT_COMPLETION_DIR="${iRCHOME}/utils/git-2.35.0/contrib/completion"
# test -f "${GIT_COMPLETION_DIR}"/git-completion.bash && source "${GIT_COMPLETION_DIR}"/git-completion.bash
# test -f "${GIT_COMPLETION_DIR}"/git-prompt.sh       && source "${GIT_COMPLETION_DIR}"/git-prompt.sh

test -f "${iRHOME}"/.alias && source "${iRHOME}"/.alias

# git completion in linux
if isLinux; then
  isDebian && GIT_COMPLETION_DIR='/opt/git/contrib/completion'
  isFedora && GIT_COMPLETION_DIR='/usr/share/doc/git/contrib/completion'
  if compgen -G "${GIT_COMPLETION_DIR}/*git*" >/dev/null; then
    for file in "${GIT_COMPLETION_DIR}"/*git*.[bs]*h; do source "${file}"; done
  fi
fi

function update-delta() {
  local repo='dandavison/delta'

  local id
  id="$(. /etc/os-release 2>/dev/null && echo "$ID")"
  if [[ "$id" != 'ubuntu' ]]; then
    echo "update-delta: only for Ubuntu (current: ${id:-unknown})" >&2
    return 1
  fi

  local latest cur
  latest=$(curl -fsSL "https://api.github.com/repos/${repo}/releases/latest" | jq -r '.tag_name')
  cur=$(delta --version 2>/dev/null | awk '{print $2}')

  if [[ "${cur}" == "${latest}" ]]; then
    echo "delta ${cur} already latest"; return 0
  fi
  echo "delta ${cur:-none} -> ${latest}"

  local url tmp
  url=$(curl -fsSL "https://api.github.com/repos/${repo}/releases/latest" |
        jq -r '.assets[] | select(.name|test("^git-delta_.*_amd64\\.deb$")) | .browser_download_url'
       )
  tmp=$(mktemp -d)
  curl -fL --progress-bar -o "${tmp}/d.deb" "${url}"
  sudo apt install -y "${tmp}/d.deb"
  rm -rf "${tmp}"
}

