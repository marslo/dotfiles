#!/usr/bin/env bash
# shellcheck source=/dev/null
#=============================================================================
#     FileName : .completion
#       Author : marslo
#      Created : 2025-11-14 20:34:08
#   LastChange : 2026-10-26 18:40:26
#=============================================================================

# /--------------------------------------------------------------
#                            _      _   _
#                           | |    | | (_)
#   ___ ___  _ __ ___  _ __ | | ___| |_ _  ___  _ __
#  / __/ _ \| '_ ` _ \| '_ \| |/ _ \ __| |/ _ \| '_ \
# | (_| (_) | | | | | | |_) | |  __/ |_| | (_) | | | |
#  \___\___/|_| |_| |_| .__/|_|\___|\__|_|\___/|_| |_|
#                     | |
#                     |_|
#
# --------------------------------------------------------------/
declare RT_COMPLETION="$HOME/.jfrog/jfrog_bash_completion"
declare BASH_COMPLETION_USER_DIR="${BASH_COMPLETION_USER_DIR:-${HOME}/.marslo/bash_completion.d}"
declare ANSIBLE_COMPLETION_PATH="${BASH_COMPLETION_USER_DIR}/ansible-completion"            # https://github.com/dysosmus/ansible-completion
# declare NPM_COMPLETION="$HOME/.npm/lib/node_modules/npm-completion"             # for npm-completion https://github.com/Jephuff/npm-bash-completion

test -f "${RT_COMPLETION}"                                     && source "${RT_COMPLETION}"
test -f "${BASH_COMPLETION_USER_DIR}"/imarslo.bash             && source "${BASH_COMPLETION_USER_DIR}"/imarslo.bash
test -f "${BASH_COMPLETION_USER_DIR}"/cht.bash/cht.bash        && source "${BASH_COMPLETION_USER_DIR}"/cht.bash/cht.bash
test -f "${BASH_COMPLETION_USER_DIR}"/complete_alias           && source "${BASH_COMPLETION_USER_DIR}"/complete_alias
test -f "${BASH_COMPLETION_USER_DIR}"/npm-groovy-lint.bash     && source "${BASH_COMPLETION_USER_DIR}"/npm-groovy-lint.bash
# for git alias completion - should load after source git-completion.sh ( after .imac/.ilinux )
test -f "${BASH_COMPLETION_USER_DIR}"/git-customize.bash       && source "${BASH_COMPLETION_USER_DIR}"/git-customize.bash
test -f "${BASH_COMPLETION_USER_DIR}"/git-completion.bash      && source "${BASH_COMPLETION_USER_DIR}"/git-completion.bash
test -f "${BASH_COMPLETION_USER_DIR}"/typos-msg.bash           && source "${BASH_COMPLETION_USER_DIR}"/typos-msg.bash

type -P commitlint >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/commitlint.bash
type -P pre-commit >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/pre-commit.bash
type -P kubectl    >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/kubectl.bash
type -P npm        >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/npm.bash
type -P gh         >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/gh.bash
type -P bat        >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/bat.bash
type -P pipx       >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/pipx.bash
type -P pip        >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/pip.bash
type -P python     >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/python.bash
type -P poetry     >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/poetry.bash
type -P code       >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/code.bash
type -P fossa      >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/fossa.bash
type -P typos      >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/typos.bash
type -P scc        >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/scc.bash
type -P extractor  >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/extractor.bash
type -P mas        >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/mas.bash
type -P tmux       >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/tmux
type -P eza        >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/eza.bash
complete -o bashdefault -o filenames -F _eza la
type -P ls-stgs.sh >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/ls-stgs.bash
type -P keyring    >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/keyring.bash
type -P tt         >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/tt.bash

type -P agent      >/dev/null || type -P cursor-agent >/dev/null && source "${BASH_COMPLETION_USER_DIR}"/cursor-agent.bash
type -P claude     >/dev/null                      && source "${BASH_COMPLETION_USER_DIR}"/claude.bash

test -L "${BASH_COMPLETION_USER_DIR}/gh-arsenal-completion.sh" && source "${BASH_COMPLETION_USER_DIR}"/gh-arsenal-completion.sh
# test -d "${NPM_COMPLETION}"                      && source "${NPM_COMPLETION}"/npm-completion.sh
# via `vault -autocomplete-install`
type -P vault      >/dev/null                      && complete -C "$(type -P vault)" vault
type -t _fd        >/dev/null 2>&1                 && complete -F _fd -o nosort -o bashdefault -o default ff ffs
# shellcheck disable=SC2015
type -t _comp_cmd_chromium_browser >/dev/null 2>&1 && complete -F _comp_cmd_chromium_browser -o nosort -o bashdefault -o default chrome || complete -o default -o bashdefault chrome
type -P batchip    >/dev/null                      && complete -o default -o bashdefault -F _bat batchip

# instead of eval "$(/bin/cat "${ANSIBLE_COMPLETION_PATH}"/*.bash)" -- for fcf
if compgen -G "${ANSIBLE_COMPLETION_PATH}/*.bash" >/dev/null; then
  shopt -s nullglob
  for script in "${ANSIBLE_COMPLETION_PATH}"/*.bash; do
    [[ -f "${script}" ]] && source "${script}"
  done
  shopt -u nullglob
fi

# >>> pythia (ai-pythia) completion >>>
test -r "${HOME}/.local/share/pythia/completion.bash" && source "${HOME}/.local/share/pythia/completion.bash"
# <<< pythia (ai-pythia) completion <<<

test -f "${BASH_COMPLETION_USER_DIR}"/bash-interp-completion.sh && source "${BASH_COMPLETION_USER_DIR}"/bash-interp-completion.sh

# vim:tabstop=2:softtabstop=2:shiftwidth=2:expandtab:filetype=sh:
