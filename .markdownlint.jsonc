{
  // marslo global markdownlint rules; applies to markdown under $HOME (cli2 walks up the tree)
  "MD013": false,   // no line-length limit
  "MD033": false,   // allow inline HTML
  "MD041": false,   // first line need not be a top-level heading
  "MD025": false,   // allow multiple top-level (#) headings as sections
  "MD060": false    // allow compact table delimiter rows (|---|---|)
}
